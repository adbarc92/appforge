*.db
*.sqlite
*.sqlite3

# Redis dump
dump.rdb

# Secrets and credentials
*.pem
*.key
secrets.yaml
secrets.json
credentials.json

# API keys (never commit these!)
.openai_api_key
.anthropic_api_key

# Local development overrides
docker-compose.override.yml
.env.development.local
.env.test.local
.env.production.local

# Temporary files
tmp/
temp/
.tmp/
.temp/

# Cache directories
.cache/
*.cache

# Project-specific
/output/
/artifacts/
/generated/
budget_logs/

# Local SQLite checkpoint/smoke databases
/data/
